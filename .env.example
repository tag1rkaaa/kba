# База данных
DATABASE_URL=postgresql+asyncpg://kba:kba@localhost:5432/kba

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (RSA ключи — генерируются через openssl)
SECRET_KEY_PRIVATE=          # содержимое private.pem
SECRET_KEY_PUBLIC=           # содержимое public.pem

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kba

# Embeddings
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# CORS (через запятую)
ALLOWED_ORIGINS=http://localhost:3000

# Поиск
SEARCH_DEFAULT_MODE=hybrid
